// GymTrack Pro schema.
// Source of truth for domain meaning: docs/DOMAIN_SPEC.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity (auth) and training profile — DOMAIN_SPEC 3.1 / 3.2
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  imageUrl  String?
  role      UserRole @default(member)
  createdAt DateTime @default(now())

  trainingProfile TrainingProfile?
}

// Physical / training attributes for the AI generator.
// userId is both PK and FK: at most one profile per user (1:1).
model TrainingProfile {
  userId          String           @id
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender          Gender?
  birthDate       DateTime?        @db.Date
  bodyWeightKg    Decimal?         @db.Decimal(5, 2)
  experienceLevel ExperienceLevel?
  preferredUnit   WeightUnit       @default(kg)
  updatedAt       DateTime         @updatedAt
}

// ---------------------------------------------------------------------------
// Enums — DOMAIN_SPEC section 4
// ---------------------------------------------------------------------------

enum Gender {
  male
  female
}

enum ExperienceLevel {
  beginner
  intermediate
  advanced
}

enum Equipment {
  barbell
  dumbbell
  machine
  cable
  smith_machine
  bodyweight
  kettlebell
  band
  other
}

enum TrackingMode {
  reps_weight
  reps_only
  time
  distance
  time_distance
}

enum IntensityTechnique {
  standard
  drop_set
  rest_pause
  cluster
  myo_reps
}

enum MediaProvider {
  youtube
  instagram
  other
}

enum WeightEntryMode {
  total
  per_side
}

enum WeightUnit {
  kg
  lb
}

enum UserRole {
  member
  curator
}

enum ExerciseDataSource {
  ai_assisted
  manual
}

enum AvoidanceReason {
  injury
  dislike
}

enum TemplateSource {
  manual
  ai_generated
}

enum MuscleGroup {
  chest
  back
  shoulders
  biceps
  triceps
  forearms
  quads
  hamstrings
  glutes
  calves
  abs
  lower_back
  neck
  full_body
}

// Starter list — extend as the catalog grows (DOMAIN_SPEC section 4).
enum MuscleEmphasis {
  chest_upper
  chest_mid
  chest_lower
  deltoid_anterior
  deltoid_lateral
  deltoid_posterior
  lat
  trap_upper
  trap_mid
  trap_lower
  rhomboid
  biceps_long_head
  biceps_short_head
  brachialis
  triceps_long_head
  triceps_lateral_head
  quad_vastus_lateralis
  quad_vastus_medialis
  quad_rectus_femoris
  hamstring_biceps_femoris
  hamstring_medial
  glute_max
  glute_med
  calf_gastrocnemius
  calf_soleus
  abs_upper
  abs_lower
  obliques
  erector_spinae
}
