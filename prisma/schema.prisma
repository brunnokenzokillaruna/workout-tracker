// GymTrack Pro schema.
// Source of truth for domain meaning: docs/DOMAIN_SPEC.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity (auth) and training profile — DOMAIN_SPEC 3.1 / 3.2
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  imageUrl  String?
  role      UserRole @default(member)
  createdAt DateTime @default(now())

  trainingProfile   TrainingProfile?
  ownedExercises    Exercise[]         @relation("ExerciseOwner")
  verifiedExercises Exercise[]         @relation("ExerciseVerifier")
  addedMedia        ExerciseMedia[]    @relation("MediaAddedBy")
  templates         WorkoutTemplate[]
  workouts          Workout[]
  avoidances        ExerciseAvoidance[]
  favoriteExercises FavoriteExercise[]
  favoriteTemplates FavoriteTemplate[]
}

// Physical / training attributes for the AI generator.
// userId is both PK and FK: at most one profile per user (1:1).
model TrainingProfile {
  userId          String           @id
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender          Gender?
  birthDate       DateTime?        @db.Date
  bodyWeightKg    Decimal?         @db.Decimal(5, 2)
  experienceLevel ExperienceLevel?
  preferredUnit   WeightUnit       @default(kg)
  updatedAt       DateTime         @updatedAt
}

// ---------------------------------------------------------------------------
// Exercise catalog — DOMAIN_SPEC 3.3 / 3.4
// ---------------------------------------------------------------------------

model Exercise {
  id                String              @id @default(cuid())
  // null = global catalog; set = personal custom exercise (decision 5.16)
  ownerId           String?
  owner             User?               @relation("ExerciseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name              String
  namePtBr          String?
  searchAliases     String[]            @default([])
  primaryMuscle     MuscleGroup
  primaryEmphasis   MuscleEmphasis[]    @default([])
  secondaryEmphasis MuscleEmphasis[]    @default([])
  emphasisRationale String?
  equipment         Equipment
  trackingMode      TrackingMode
  formCues          String?
  dataSource        ExerciseDataSource
  wasGrounded       Boolean             @default(false)
  isVerified        Boolean             @default(false)
  verifiedById      String?
  verifiedBy        User?               @relation("ExerciseVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt        DateTime?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())

  media                 ExerciseMedia[]
  templateExercises     TemplateExercise[]
  workoutExercises      WorkoutExercise[]  @relation("WorkoutExerciseCurrent")
  swappedFromInSessions WorkoutExercise[]  @relation("WorkoutExerciseSwappedFrom")
  avoidances            ExerciseAvoidance[]
  favoritedBy           FavoriteExercise[]

  @@index([ownerId])
  @@index([primaryMuscle])
  @@index([equipment])
  @@index([isVerified])
  @@index([primaryEmphasis], type: Gin)
  @@index([secondaryEmphasis], type: Gin)
  // Fuzzy bilingual search / dedupe (requires pg_trgm — see search trigram migration)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Exercise_name_trgm_idx")
  @@index([namePtBr(ops: raw("gin_trgm_ops"))], type: Gin, map: "Exercise_namePtBr_trgm_idx")
  @@index([searchAliases], type: Gin, map: "Exercise_searchAliases_gin_idx")
}

model ExerciseMedia {
  id            String        @id @default(cuid())
  exerciseId    String
  exercise      Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  provider      MediaProvider
  url           String
  label         String?
  addedById     String?
  addedBy       User?         @relation("MediaAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  lastCheckedAt DateTime?
  isBroken      Boolean       @default(false)

  @@index([exerciseId])
  @@index([provider])
}

// ---------------------------------------------------------------------------
// Templates — DOMAIN_SPEC 3.5 (plan only; load comes from last performance)
// ---------------------------------------------------------------------------

model WorkoutTemplate {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  notes      String?
  source     TemplateSource
  isArchived Boolean        @default(false)
  createdAt  DateTime       @default(now())

  exercises TemplateExercise[]
  workouts  Workout[]
  favoritedBy FavoriteTemplate[]

  @@index([userId])
}

model TemplateExercise {
  id              String             @id @default(cuid())
  templateId      String
  template        WorkoutTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  position        Int
  targetSets      Int?
  targetRepsMin   Int?
  targetRepsMax   Int?
  targetTechnique IntensityTechnique @default(standard)
  restSeconds     Int?

  @@unique([templateId, position])
  @@index([templateId])
  @@index([exerciseId])
}

// ---------------------------------------------------------------------------
// Live sessions — DOMAIN_SPEC 3.6 / 3.7
// Template data is copied into these rows; templateId is provenance only.
// ---------------------------------------------------------------------------

model Workout {
  id                    String           @id @default(cuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId            String?
  template              WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateNameSnapshot  String?
  startedAt             DateTime         @default(now())
  finishedAt            DateTime?
  notes                 String?

  exercises WorkoutExercise[]

  @@index([userId, startedAt(sort: Desc)])
}

model WorkoutExercise {
  id                     String    @id @default(cuid())
  workoutId              String
  workout                Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId             String
  exercise               Exercise  @relation("WorkoutExerciseCurrent", fields: [exerciseId], references: [id], onDelete: Restrict)
  position               Int
  restSeconds            Int?
  swappedFromExerciseId  String?
  swappedFrom            Exercise? @relation("WorkoutExerciseSwappedFrom", fields: [swappedFromExerciseId], references: [id], onDelete: SetNull)

  sets WorkoutSet[]

  @@unique([workoutId, position])
  @@index([workoutId])
  @@index([exerciseId])
}

model WorkoutSet {
  id                String               @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise      @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  // null = parent set; set = later stage of that parent (drop set / rest-pause / cluster / myo-reps)
  parentSetId       String?
  parentSet         WorkoutSet?          @relation("SetStages", fields: [parentSetId], references: [id], onDelete: Cascade)
  stages            WorkoutSet[]         @relation("SetStages")
  stageIndex        Int                  @default(0)
  setNumber         Int?
  // Meaningful on parents only; stages leave this null (domain rule 1)
  technique         IntensityTechnique?
  weightKg          Decimal?             @db.Decimal(7, 2)
  enteredWeight     Decimal?             @db.Decimal(6, 2)
  enteredUnit       WeightUnit?
  weightEntryMode   WeightEntryMode?
  reps              Int?
  durationSeconds   Int?
  distanceMeters    Decimal?             @db.Decimal(8, 2)
  rpe               Decimal?             @db.Decimal(3, 1)
  // Rest taken before this stage; stages only (decision 5.10)
  intraRestSeconds  Int?
  isCompleted       Boolean              @default(false)
  completedAt       DateTime?

  @@index([workoutExerciseId])
  @@index([parentSetId])
}

// ---------------------------------------------------------------------------
// Avoid list and favorites — DOMAIN_SPEC 3.8 / 3.9
// ---------------------------------------------------------------------------

model ExerciseAvoidance {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  reason     AvoidanceReason
  note       String?
  createdAt  DateTime        @default(now())

  @@unique([userId, exerciseId])
  @@index([userId])
}

model FavoriteExercise {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, exerciseId])
}

model FavoriteTemplate {
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@id([userId, templateId])
}

// ---------------------------------------------------------------------------
// Enums — DOMAIN_SPEC section 4
// ---------------------------------------------------------------------------

enum Gender {
  male
  female
}

enum ExperienceLevel {
  beginner
  intermediate
  advanced
}

enum Equipment {
  barbell
  dumbbell
  machine
  cable
  smith_machine
  bodyweight
  kettlebell
  band
  other
}

enum TrackingMode {
  reps_weight
  reps_only
  time
  distance
  time_distance
}

enum IntensityTechnique {
  standard
  drop_set
  rest_pause
  cluster
  myo_reps
}

enum MediaProvider {
  youtube
  instagram
  other
}

enum WeightEntryMode {
  total
  per_side
}

enum WeightUnit {
  kg
  lb
}

enum UserRole {
  member
  curator
}

enum ExerciseDataSource {
  ai_assisted
  manual
}

enum AvoidanceReason {
  injury
  dislike
}

enum TemplateSource {
  manual
  ai_generated
}

enum MuscleGroup {
  chest
  back
  shoulders
  biceps
  triceps
  forearms
  quads
  hamstrings
  glutes
  calves
  abs
  lower_back
  neck
  full_body
}

// Starter list — extend as the catalog grows (DOMAIN_SPEC section 4).
enum MuscleEmphasis {
  chest_upper
  chest_mid
  chest_lower
  deltoid_anterior
  deltoid_lateral
  deltoid_posterior
  lat
  trap_upper
  trap_mid
  trap_lower
  rhomboid
  biceps_long_head
  biceps_short_head
  brachialis
  triceps_long_head
  triceps_lateral_head
  quad_vastus_lateralis
  quad_vastus_medialis
  quad_rectus_femoris
  hamstring_biceps_femoris
  hamstring_medial
  glute_max
  glute_med
  calf_gastrocnemius
  calf_soleus
  abs_upper
  abs_lower
  obliques
  erector_spinae
}
