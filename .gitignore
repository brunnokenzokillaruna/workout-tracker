# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/
/build/
dist/

# Environment variables — never commit secrets.
# This repository is public: a committed credential is a leaked credential,
# and it stays in the history even after being deleted.
.env*
!.env.example

# Certificates and keys
*.pem
*.key

# Testing
/coverage
playwright-report/
test-results/
blob-report/
.playwright/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Prisma local artifacts
prisma/*.db
prisma/*.db-journal

# Vercel / Amplify local
.vercel
.amplify/
amplify_outputs*.json

# Agent tooling installed into the workspace, not part of the project
.agents/
skills-lock.json

# Personal study notes — kept out of the portfolio repository by choice.
# NOTE: this means they have no backup and no history. Copy them elsewhere.
docs/learning/
